---
// frontmatter 문자열(어디서/언제까지/준비물)에 쓴 [확인 필요]도 배지로 보여 준다.
import { VERIFY_MARK } from '../plugins/remark-verify.mjs';

interface Props {
	text: string;
}
const parts = Astro.props.text.split(VERIFY_MARK);
---

{
	parts.map((part, i) => (
		<>
			{part}
			{i < parts.length - 1 && (
				<span class="verify-badge" title="공식 출처로 아직 확인하지 못한 내용입니다">
					확인 필요
				</span>
			)}
		</>
	))
}
