---
// 체크리스트 항목 카드: 무엇을 / 어디서 / 언제까지 / 준비물 / 놓치기 쉬운 점
import { render, type CollectionEntry } from 'astro:content';
import Ja from './Ja.astro';
import Sources from './Sources.astro';
import ExpertNote from './ExpertNote.astro';
import VerifyText from './VerifyText.astro';
import { phaseOf } from '../lib/taxonomy';

interface Props {
	task: CollectionEntry<'tasks'>;
	showPhase?: boolean;
	/** 처음부터 펼쳐 보여 줄지 (할 일 개별 페이지) */
	open?: boolean;
	/** 할 일 개별 페이지 안이면 true — 자기 페이지 링크를 숨긴다 */
	standalone?: boolean;
}
const { task, showPhase = false, open = false, standalone = false } = Astro.props;
const { data } = task;
const { Content } = await render(task);
const inputId = `task-${task.id}`;
const phase = phaseOf(data.phase);
---

<div class="task-card" data-task-card={task.id}>
	<label class="task-check-wrap" for={inputId}>
		<input
			class="task-check"
			type="checkbox"
			id={inputId}
			data-task-id={task.id}
			aria-label={`${data.title} 완료 표시`}
		/>
	</label>
	<details class="task-details" open={open}>
		<summary>
			<span class="task-title">
				{data.title}
				{data.optional && <span class="task-tag">선택</span>}
			</span>
			{data.term && <Ja t={data.term.ja} r={data.term.reading} />}
			<span class="task-deadline">
				{showPhase && phase && <span class="task-phase">{phase.label} · </span>}
				<VerifyText text={data.deadline} />
			</span>
		</summary>

		<dl class="task-facts">
			<dt>어디서</dt>
			<dd><VerifyText text={data.where} /></dd>
			<dt>언제까지</dt>
			<dd><VerifyText text={data.deadline} /></dd>
			{
				data.bring.length > 0 && (
					<>
						<dt>준비물</dt>
						<dd>
							<ul>
								{data.bring.map((b) => (
									<li>
										<VerifyText text={b} />
									</li>
								))}
							</ul>
						</dd>
					</>
				)
			}
		</dl>

		{data.needsExpert && <ExpertNote />}

		<div class="task-body sl-markdown-content">
			<Content />
		</div>

		<Sources sources={data.sources} lastVerified={data.lastVerified} />
		{!standalone && <a class="task-permalink" href={`/tasks/${task.id}/`}>이 할 일 페이지로 가기 →</a>}
	</details>
</div>
