---
// 일본 집 초기비용 계산기. 입력값은 브라우저 안에서만 계산하고 어디에도 저장하지 않는다.
import Ja from './Ja.astro';
import { EXTRAS, PRESETS } from '../lib/initial-cost';

const SEGMENTS = [
	{
		name: 'shiki', label: '시키킨 (보증금)', ja: '敷金', reading: '시키킨', checked: '1',
		options: [['0', '0개월'], ['1', '1개월'], ['2', '2개월']],
		help: '퇴거 때 정산하고 남은 돈을 돌려받습니다.',
	},
	{
		name: 'rei', label: '레이킨 (사례금)', ja: '礼金', reading: '레이킨', checked: '1',
		options: [['0', '0개월'], ['1', '1개월'], ['2', '2개월']],
		help: '돌려받지 못합니다.',
	},
	{
		name: 'fee', label: '중개수수료 (부가세 포함)', ja: '仲介手数料', reading: '주카이 데스료', checked: '1.1',
		options: [['0', '없음'], ['0.55', '0.55개월'], ['1.1', '1.1개월']],
		help: '세입자 한쪽에서 받는 상한은 원칙적으로 0.55개월분입니다. 세입자가 미리 승낙하면 최대 1.1개월분까지 받을 수 있습니다.',
	},
	{
		name: 'guar', label: '보증회사 초회 보증료', ja: '保証料', reading: '호쇼료', checked: '0.5',
		options: [['0', '없음'], ['0.35', '35%'], ['0.5', '50%'], ['1', '100%']],
		help: '집세+관리비 기준입니다. 연대보증인을 세우면 "없음"을 고르세요.',
	},
];
---

<div class="cost-calc not-content">
	<div class="cost-grid">
		<form id="cost-form" autocomplete="off" novalidate>
			<div class="cost-presets" role="group" aria-label="예시 조건">
				<span>예시 조건</span>
				{
					Object.entries(PRESETS).map(([key, p]) => (
						<button type="button" data-preset={key} aria-pressed={key === 'std' ? 'true' : 'false'}>
							{p.label}
						</button>
					))
				}
			</div>

			<fieldset>
				<legend>매달 내는 돈</legend>
				<div class="cost-row">
					<div class="cost-field">
						<label for="cost-rent">집세 <Ja t="家賃" r="야친" /></label>
						<div class="cost-money"><input id="cost-rent" inputmode="numeric" value="85,000" /><span>엔</span></div>
					</div>
					<div class="cost-field">
						<label for="cost-mgmt">관리비·공익비 <Ja t="管理費" r="간리히" /></label>
						<div class="cost-money"><input id="cost-mgmt" inputmode="numeric" value="5,000" /><span>엔</span></div>
					</div>
				</div>
			</fieldset>

			<fieldset>
				<legend>계약 조건</legend>
				{
					SEGMENTS.map((g) => (
						<div class="cost-field">
							<span id={`cost-l-${g.name}`}>
								{g.label} <Ja t={g.ja} r={g.reading} />
							</span>
							<div class="cost-seg" role="radiogroup" aria-labelledby={`cost-l-${g.name}`}>
								{g.options.map(([value, text]) => (
									<label>
										<input type="radio" name={g.name} value={value} checked={value === g.checked} />
										<span>{text}</span>
									</label>
								))}
							</div>
							<small>{g.help}</small>
						</div>
					))
				}
			</fieldset>

			<fieldset>
				<legend>입주일과 선불 집세</legend>
				<div class="cost-row">
					<div class="cost-field">
						<label for="cost-date">입주(계약 시작)일</label>
						<input type="date" id="cost-date" />
						<small>달 중간에 들어가면 그달 남은 날짜만큼 일할 계산합니다.</small>
					</div>
					<div class="cost-field">
						<span>다음 달 집세</span>
						<label class="cost-toggle">
							<input type="checkbox" id="cost-next" checked />
							<span>계약할 때 같이 낸다<small>일본은 집세를 전달 말까지 미리 냅니다.</small></span>
						</label>
					</div>
				</div>
			</fieldset>

			<fieldset>
				<legend>그 밖의 비용 (금액은 직접 고칠 수 있습니다)</legend>
				{
					EXTRAS.map((x) => (
						<div class="cost-extra">
							<label class="cost-toggle">
								<input type="checkbox" id={`cost-x-${x.id}`} checked={x.on} />
								<span>
									{x.label} <Ja t={x.ja} r={x.reading} />
									{x.note && <small>{x.note}</small>}
								</span>
							</label>
							<div class="cost-money">
								<input
									id={`cost-a-${x.id}`}
									inputmode="numeric"
									value={x.amount.toLocaleString('ko-KR')}
									aria-label={`${x.label} 금액`}
								/>
								<span>엔</span>
							</div>
						</div>
					))
				}
			</fieldset>

			<fieldset>
				<legend>원화 환산</legend>
				<div class="cost-field cost-fx">
					<label for="cost-fx">100엔당 원화</label>
					<div class="cost-money"><input id="cost-fx" inputmode="decimal" value="930" /><span>원</span></div>
					<small>예시 환율입니다. 송금 당일 환율로 고쳐 넣으세요.</small>
				</div>
			</fieldset>
		</form>

		<aside class="cost-sheet" id="cost-sheet" aria-label="초기비용 견적">
			<div class="cost-sheet-head"><h2>초기비용 견적</h2><span>예상</span></div>
			<div class="cost-total" aria-live="polite">
				<span>계약할 때 내는 돈</span>
				<strong id="cost-total">0엔</strong>
				<span id="cost-sub"></span>
			</div>
			<div class="cost-split" aria-hidden="true"><div class="is-keep" id="cost-bar-keep"></div><div class="is-gone" id="cost-bar-gone"></div></div>
			<div class="cost-legend">
				<span><i class="is-keep"></i>나중에 돌려받을 수 있음 <b id="cost-keep">0엔</b></span>
				<span><i class="is-gone"></i>돌려받지 못함 <b id="cost-gone">0엔</b></span>
			</div>
			<dl id="cost-items"></dl>
			<div class="cost-actions">
				<button type="button" id="cost-copy">결과 복사해서 공유</button>
				<button type="button" id="cost-reset" class="is-ghost">처음 값으로</button>
			</div>
			<div class="cost-status" id="cost-status" role="status"></div>
		</aside>
	</div>

	<div class="cost-bar"><span>초기비용 합계 <b id="cost-bar-total">0엔</b></span><a href="#cost-sheet">내역 보기</a></div>
</div>

<script>
	import { calcCost, defaultMoveIn, EXTRAS, PRESETS } from '../lib/initial-cost';

	const $ = <T extends HTMLElement = HTMLInputElement>(id: string) => document.getElementById(`cost-${id}`) as T;
	const form = $<HTMLFormElement>('form');
	const yen = (n: number) => `${Math.round(n).toLocaleString('ko-KR')}엔`;
	const num = (el: HTMLInputElement) => {
		const v = parseFloat(el.value.replace(/[^0-9.]/g, ''));
		return Number.isFinite(v) ? v : 0;
	};
	const radio = (name: string) => parseFloat(new FormData(form).get(name) as string) || 0;
	const setRadio = (name: string, v: number) => {
		const el = form.querySelector<HTMLInputElement>(`input[name="${name}"][value="${v}"]`);
		if (el) el.checked = true;
	};
	const man = (krw: number) => `약 ${Math.round(krw / 10000).toLocaleString('ko-KR')}만 원`;

	const read = () => ({
		rent: num($('rent')),
		mgmt: num($('mgmt')),
		shiki: radio('shiki'),
		rei: radio('rei'),
		fee: radio('fee'),
		guar: radio('guar'),
		date: $('date').value,
		next: $('next').checked,
		extras: EXTRAS.map((x) => ({ label: x.label, note: x.note, amount: num($(`a-${x.id}`)), on: $(`x-${x.id}`).checked })),
	});

	function render() {
		const s = read();
		const r = calcCost(s);
		const fx = num($('fx'));
		$('total').textContent = yen(r.total);
		$('bar-total').textContent = yen(r.total);
		$('sub').textContent = [
			r.months ? `집세의 ${r.months.toFixed(1)}개월분` : '',
			fx ? `${man((r.total * fx) / 100)} (100엔 = ${fx}원)` : '',
		]
			.filter(Boolean)
			.join(' · ');
		const keepPct = r.total ? (r.keep / r.total) * 100 : 0;
		$('bar-keep').style.width = `${keepPct}%`;
		$('bar-gone').style.width = `${r.total ? 100 - keepPct : 0}%`;
		$('keep').textContent = yen(r.keep);
		$('gone').textContent = yen(r.gone);
		$('items').replaceChildren(
			...r.items.map((it) => {
				const row = document.createElement('div');
				if (!it.amount) row.className = 'is-zero';
				const dt = document.createElement('dt');
				dt.textContent = it.label;
				if (it.amount) {
					const tag = document.createElement('span');
					tag.className = it.keep ? 'cost-tag is-keep' : 'cost-tag is-gone';
					tag.textContent = it.keep ? '반환' : '소멸';
					dt.append(tag);
				}
				if (it.note) {
					const note = document.createElement('small');
					note.textContent = it.note;
					dt.append(note);
				}
				const dd = document.createElement('dd');
				dd.textContent = yen(it.amount);
				row.append(dt, dd);
				return row;
			}),
		);
		$('status').textContent = '';
		return { s, r, fx };
	}

	const pressPreset = (key: string | null) =>
		form.querySelectorAll<HTMLButtonElement>('[data-preset]').forEach((b) => {
			b.setAttribute('aria-pressed', String(b.dataset.preset === key));
		});

	function applyPreset(key: keyof typeof PRESETS) {
		const p = PRESETS[key];
		setRadio('shiki', p.shiki);
		setRadio('rei', p.rei);
		setRadio('fee', p.fee);
		setRadio('guar', p.guar);
		$('next').checked = p.next;
		for (const x of EXTRAS) $(`x-${x.id}`).checked = (p.extras as readonly string[]).includes(x.id);
		pressPreset(key);
		render();
	}

	form.querySelectorAll<HTMLButtonElement>('[data-preset]').forEach((b) => {
		b.addEventListener('click', () => applyPreset(b.dataset.preset as keyof typeof PRESETS));
	});
	form.addEventListener('input', (e) => {
		const t = e.target as HTMLInputElement;
		if (t.type === 'radio' || t.type === 'checkbox') pressPreset(null);
		render();
	});
	form.addEventListener('submit', (e) => e.preventDefault());
	form.querySelectorAll<HTMLInputElement>('.cost-money input').forEach((el) => {
		if (el.id === 'cost-fx') return;
		el.addEventListener('blur', () => {
			const v = num(el);
			el.value = v ? v.toLocaleString('ko-KR') : '';
		});
	});

	$('reset').addEventListener('click', () => {
		form.reset();
		$('date').value = defaultMoveIn();
		applyPreset('std');
	});

	$('copy').addEventListener('click', () => {
		const { s, r, fx } = render();
		const text = [
			'[일본 집 초기비용 예상]',
			`집세 ${yen(s.rent)} + 관리비 ${yen(s.mgmt)}`,
			'',
			...r.items.filter((it) => it.amount).map((it) => `· ${it.label}: ${yen(it.amount)}`),
			'',
			`합계: ${yen(r.total)} (집세의 ${r.months.toFixed(1)}개월분)`,
			...(fx ? [`원화 ${man((r.total * fx) / 100)}`] : []),
			`그중 돌려받을 수 있는 돈(시키킨): ${yen(r.keep)}`,
			'',
			`계산해 보기: ${location.origin}${location.pathname}`,
		].join('\n');
		const status = $('status');
		const fallback = () => {
			document.querySelector('.cost-fallback')?.remove();
			const ta = document.createElement('textarea');
			ta.className = 'cost-fallback';
			ta.value = text;
			ta.readOnly = true;
			status.textContent = '자동 복사를 쓸 수 없습니다. 아래 내용을 길게 눌러 복사하세요.';
			status.after(ta);
			ta.select();
		};
		if (!navigator.clipboard) return fallback();
		navigator.clipboard.writeText(text).then(() => {
			status.textContent = '복사했습니다. 카카오톡이나 메모에 붙여 넣으세요.';
		}, fallback);
	});

	$('date').value = defaultMoveIn();
	render();
</script>

<style is:global>
	/* 동적으로 만드는 항목에도 적용되도록 전역 스타일로 쓰고 .cost-calc 아래로만 한정한다. 이 페이지에서만 불러온다. */
	.cost-calc {
		--c-keep: var(--krds-color-light-success-30);
		--c-keep-soft: var(--krds-color-light-success-90);
		--c-gone: var(--krds-color-light-danger-30);
		--c-gone-soft: var(--krds-color-light-danger-90);
		margin-block: 1.5rem;
		font-size: var(--sl-text-sm);
	}
	:root[data-theme='light'] .cost-calc {
		--c-keep: var(--krds-color-light-success-60);
		--c-keep-soft: var(--krds-color-light-success-5);
		--c-gone: var(--krds-color-light-danger-60);
		--c-gone-soft: var(--krds-color-light-danger-5);
	}
	.cost-grid {
		display: grid;
		gap: 1.5rem;
		align-items: start;
	}
	.cost-calc small {
		display: block;
		color: var(--sl-color-gray-3);
		font-size: var(--sl-text-xs);
		line-height: 1.5;
	}
	.cost-calc .ja-term {
		font-size: var(--sl-text-xs);
		font-weight: 400;
	}
	.cost-calc .ja-word {
		color: var(--sl-color-gray-2);
	}
	.cost-calc input,
	.cost-calc button {
		font: inherit;
	}
	.cost-calc :is(input, button, a):focus-visible {
		outline: 2px solid var(--sl-color-accent);
		outline-offset: 2px;
	}

	.cost-presets {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.5rem;
		margin-bottom: 1rem;
		color: var(--sl-color-gray-3);
	}
	.cost-presets button {
		min-height: 2.75rem;
		padding: 0 0.85rem;
		border: 1px solid var(--sl-color-gray-4);
		border-radius: var(--radius);
		background: transparent;
		color: var(--sl-color-white);
		cursor: pointer;
	}
	.cost-presets button:hover {
		border-color: var(--sl-color-accent);
	}
	.cost-presets button[aria-pressed='true'] {
		border-color: var(--sl-color-accent);
		background: var(--sl-color-accent);
		color: var(--c-on-accent);
	}

	.cost-calc fieldset {
		display: grid;
		gap: 1rem;
		min-width: 0;
		margin: 0;
		padding: 1.1rem 0;
		border: 0;
		border-top: 1px solid var(--sl-color-hairline);
	}
	.cost-calc legend {
		float: left;
		width: 100%;
		padding: 0;
		color: var(--sl-color-white);
		font-weight: 700;
	}
	.cost-row {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(11rem, 1fr));
		gap: 1rem;
	}
	.cost-field {
		display: grid;
		gap: 0.35rem;
		min-width: 0;
		align-content: start;
		color: var(--sl-color-white);
	}
	.cost-fx {
		max-width: 16rem;
	}
	.cost-money {
		position: relative;
	}
	.cost-money input,
	.cost-calc input[type='date'] {
		width: 100%;
		min-height: 2.75rem;
		padding: 0 0.75rem;
		border: 1px solid var(--sl-color-gray-4);
		border-radius: var(--radius);
		background: var(--sl-color-bg);
		color: var(--sl-color-white);
	}
	.cost-money input {
		padding-right: 2.25rem;
		font-size: 1rem; /* 16px 미만이면 iOS가 입력할 때 화면을 확대한다 */
		font-weight: 600;
		font-variant-numeric: tabular-nums;
	}
	.cost-money span {
		position: absolute;
		top: 50%;
		right: 0.75rem;
		transform: translateY(-50%);
		color: var(--sl-color-gray-3);
	}

	.cost-seg {
		display: flex;
		overflow: hidden;
		border: 1px solid var(--sl-color-gray-4);
		border-radius: var(--radius);
	}
	.cost-seg label {
		position: relative;
		flex: 1 1 0;
		min-width: 0;
		cursor: pointer;
	}
	.cost-seg label + label {
		border-left: 1px solid var(--sl-color-gray-4);
	}
	.cost-seg input {
		position: absolute;
		inset: 0;
		margin: 0;
		opacity: 0;
		cursor: pointer;
	}
	.cost-seg span {
		display: block;
		padding: 0.6rem 0.2rem;
		text-align: center;
		white-space: nowrap;
	}
	.cost-seg input:checked + span {
		background: var(--sl-color-accent-low);
		color: var(--sl-color-text-accent);
		font-weight: 700;
	}
	.cost-seg input:focus-visible + span {
		outline: 2px solid var(--sl-color-accent);
		outline-offset: -2px;
	}

	.cost-toggle {
		display: flex;
		gap: 0.6rem;
		align-items: flex-start;
		color: var(--sl-color-white);
		cursor: pointer;
	}
	.cost-toggle input {
		flex: none;
		width: 1.15rem;
		height: 1.15rem;
		margin: 0.2rem 0 0;
		accent-color: var(--sl-color-accent);
	}
	.cost-extra {
		display: grid;
		grid-template-columns: minmax(0, 1fr) 8.5rem;
		gap: 0.75rem;
		align-items: center;
	}

	.cost-sheet {
		padding: 1.25rem;
		border: 1px solid var(--sl-color-hairline);
		border-radius: var(--radius);
		background: var(--sl-color-bg);
		color: var(--sl-color-white);
		scroll-margin-top: calc(var(--sl-nav-height) + 1rem);
	}
	.cost-sheet-head {
		display: flex;
		justify-content: space-between;
		align-items: baseline;
		padding-bottom: 0.5rem;
		border-bottom: 2px solid var(--sl-color-white);
		color: var(--sl-color-gray-3);
	}
	.cost-sheet-head h2 {
		margin: 0;
		color: var(--sl-color-white);
		font-size: var(--sl-text-lg);
		font-weight: 700;
	}
	.cost-total {
		display: grid;
		gap: 0.1rem;
		padding-block: 1rem 0.75rem;
		color: var(--sl-color-gray-3);
	}
	.cost-total strong {
		color: var(--sl-color-white);
		font-size: var(--sl-text-3xl);
		font-weight: 700;
		line-height: 1.2;
		letter-spacing: -0.01em;
		font-variant-numeric: tabular-nums;
	}
	.cost-split {
		display: flex;
		height: 6px;
		overflow: hidden;
		background: var(--sl-color-gray-5);
	}
	.cost-calc .is-keep {
		--c: var(--c-keep);
		--c-soft: var(--c-keep-soft);
	}
	.cost-calc .is-gone {
		--c: var(--c-gone);
		--c-soft: var(--c-gone-soft);
	}
	.cost-split div {
		background: var(--c);
	}
	.cost-legend {
		display: grid;
		gap: 0.1rem;
		margin-top: 0.5rem;
		color: var(--sl-color-gray-3);
		font-size: var(--sl-text-xs);
	}
	.cost-legend i {
		display: inline-block;
		width: 0.5rem;
		height: 0.5rem;
		margin-right: 0.35rem;
		background: var(--c);
	}
	.cost-legend b {
		color: var(--sl-color-white);
		font-variant-numeric: tabular-nums;
	}
	.cost-calc dl {
		margin: 0.75rem 0 0;
	}
	.cost-calc dl > div {
		display: flex;
		justify-content: space-between;
		gap: 0.75rem;
		padding-block: 0.45rem;
		border-bottom: 1px solid var(--sl-color-hairline);
	}
	.cost-calc dd {
