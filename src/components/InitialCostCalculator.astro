---
// 일본 집 초기비용 계산기. 입력값은 브라우저 안에서만 계산하고 어디에도 저장하지 않는다.
import Ja from './Ja.astro';
import { EXTRAS, PRESETS } from '../lib/initial-cost';

const FX_EXAMPLE_NOTE = '예시 환율입니다. 송금 당일 환율로 고쳐 넣으세요.';

const SEGMENTS = [
	{
		name: 'shiki', label: '시키킨 (보증금)', ja: '敷金', reading: '시키킨', checked: '1',
		options: [['0', '0개월'], ['1', '1개월'], ['2', '2개월']],
		help: '퇴거 때 정산하고 남은 돈을 돌려받습니다.',
	},
	{
		name: 'rei', label: '레이킨 (사례금)', ja: '礼金', reading: '레이킨', checked: '1',
		options: [['0', '0개월'], ['1', '1개월'], ['2', '2개월']],
		help: '돌려받지 못합니다.',
	},
	{
		name: 'fee', label: '중개수수료 (부가세 포함)', ja: '仲介手数料', reading: '주카이 데스료', checked: '1.1',
		options: [['0', '없음'], ['0.55', '0.55개월'], ['1.1', '1.1개월']],
		help: '세입자 한쪽에서 받는 상한은 원칙적으로 0.55개월분입니다. 세입자가 미리 승낙하면 최대 1.1개월분까지 받을 수 있습니다.',
	},
	{
		name: 'guar', label: '보증회사 초회 보증료', ja: '保証料', reading: '호쇼료', checked: '0.5',
		options: [['0', '없음'], ['0.35', '35%'], ['0.5', '50%'], ['1', '100%']],
		help: '집세+관리비 기준입니다. 연대보증인을 세우면 "없음"을 고르세요.',
	},
];
---

<div class="cost-calc not-content" data-fx-example-note={FX_EXAMPLE_NOTE}>
	<div class="cost-bar">
		<div class="cost-bar-line">
			<span>합계</span>
			<b id="cost-bar-total">0엔</b>
			<span class="cost-delta" id="cost-bar-delta"></span>
			<a href="#cost-sheet">내역 보기</a>
		</div>
		<div class="cost-split" aria-hidden="true"><div class="is-keep" id="cost-mini-keep"></div><div class="is-gone" id="cost-mini-gone"></div></div>
	</div>

	<div class="cost-grid">
		<form id="cost-form" autocomplete="off" novalidate>
			<div class="cost-presets" role="group" aria-label="예시 조건">
				<span>예시 조건</span>
				{
					Object.entries(PRESETS).map(([key, p]) => (
						<button type="button" data-preset={key} aria-pressed={key === 'std' ? 'true' : 'false'}>
							{p.label}
						</button>
					))
				}
			</div>

			<fieldset>
				<legend>매달 내는 돈</legend>
				<div class="cost-row">
					<div class="cost-field">
						<label for="cost-rent">집세 <Ja t="家賃" r="야친" /></label>
						<div class="cost-money"><input id="cost-rent" inputmode="numeric" value="85,000" /><span>엔</span></div>
					</div>
					<div class="cost-field">
						<label for="cost-mgmt">관리비·공익비 <Ja t="管理費" r="간리히" /></label>
						<div class="cost-money"><input id="cost-mgmt" inputmode="numeric" value="5,000" /><span>엔</span></div>
					</div>
				</div>
			</fieldset>

			<fieldset>
				<legend>계약 조건</legend>
				{
					SEGMENTS.map((g) => (
						<div class="cost-field">
							<span id={`cost-l-${g.name}`}>
								{g.label} <Ja t={g.ja} r={g.reading} />
							</span>
							<div class="cost-seg" role="radiogroup" aria-labelledby={`cost-l-${g.name}`}>
								{g.options.map(([value, text]) => (
									<label>
										<input type="radio" name={g.name} value={value} checked={value === g.checked} />
										<span>{text}</span>
									</label>
								))}
							</div>
							<small>{g.help}</small>
						</div>
					))
				}
			</fieldset>

			<fieldset>
				<legend>입주일과 선불 집세</legend>
				<div class="cost-row">
					<div class="cost-field">
						<label for="cost-date">입주(계약 시작)일</label>
						<input type="date" id="cost-date" />
						<small>달 중간에 들어가면 그달 남은 날짜만큼 일할 계산합니다.</small>
					</div>
					<div class="cost-field">
						<span>다음 달 집세</span>
						<label class="cost-toggle">
							<input type="checkbox" id="cost-next" checked />
							<span>계약할 때 같이 낸다<small>일본은 집세를 전달 말까지 미리 냅니다.</small></span>
						</label>
					</div>
				</div>
			</fieldset>

			<fieldset>
				<legend>그 밖의 비용 (금액은 직접 고칠 수 있습니다)</legend>
				{
					EXTRAS.map((x) => (
						<div class="cost-extra">
							<label class="cost-toggle">
								<input type="checkbox" id={`cost-x-${x.id}`} checked={x.on} />
								<span>
									{x.label} <Ja t={x.ja} r={x.reading} />
									{x.note && <small>{x.note}</small>}
								</span>
							</label>
							<div class="cost-money">
								<input
									id={`cost-a-${x.id}`}
									inputmode="numeric"
									value={x.amount.toLocaleString('ko-KR')}
									aria-label={`${x.label} 금액`}
								/>
								<span>엔</span>
							</div>
						</div>
					))
				}
			</fieldset>

			<fieldset>
				<legend>원화 환산</legend>
				<div class="cost-field cost-fx">
					<label for="cost-fx">100엔당 원화</label>
					<div class="cost-money"><input id="cost-fx" inputmode="decimal" value="860" /><span>원</span></div>
					<small id="cost-fx-note">{FX_EXAMPLE_NOTE}</small>
				</div>
			</fieldset>
		</form>

		<aside class="cost-side" aria-label="초기비용 견적">
			<div class="cost-sheet" id="cost-sheet">
				<div class="cost-sheet-head"><h2>초기비용 견적</h2><span>예상</span></div>
				<dl id="cost-items"></dl>
				<div class="cost-total">
					<div class="cost-total-label"><span>계약할 때 내는 돈</span><span class="cost-delta" id="cost-delta"></span></div>
					<strong id="cost-total">0엔</strong>
					<span id="cost-sub"></span>
					<span class="sr-only" id="cost-live" aria-live="polite"></span>
				</div>
				<div class="cost-split" aria-hidden="true"><div class="is-keep" id="cost-bar-keep"></div><div class="is-gone" id="cost-bar-gone"></div></div>
				<div class="cost-legend">
					<span><i class="is-keep"></i>나중에 돌려받을 수 있음 <b id="cost-keep">0엔</b></span>
					<span><i class="is-gone"></i>돌려받지 못함 <b id="cost-gone">0엔</b></span>
				</div>
			</div>
			<div class="cost-cta">
				<div class="cost-actions">
					<button type="button" id="cost-share">결과 이미지로 공유</button>
					<button type="button" id="cost-reset" class="is-ghost">처음 값으로</button>
				</div>
			</div>
		</aside>
	</div>

	<dialog class="cost-dialog" id="cost-dialog" aria-labelledby="cost-dialog-title">
		<div class="cost-dialog-head">
			<h2 id="cost-dialog-title">결과 공유</h2>
			<button type="button" id="cost-close" class="is-ghost">닫기</button>
		</div>
		<img id="cost-image" alt="" />
		<div class="cost-actions">
			<button type="button" id="cost-img-share" hidden>이미지 공유</button>
			<button type="button" id="cost-img-copy" hidden>이미지 복사</button>
			<button type="button" id="cost-img-save" class="is-ghost">이미지 저장</button>
			<button type="button" id="cost-copy" class="is-ghost">글로 복사</button>
		</div>
		<div class="cost-status" id="cost-status" role="status"></div>
	</dialog>

</div>

<script>
	import { calcCost, defaultMoveIn, EXTRAS, PRESETS } from '../lib/initial-cost';
	import { drawShareCard } from '../scripts/cost-share-image';

	const $ = <T extends HTMLElement = HTMLInputElement>(id: string) => document.getElementById(`cost-${id}`) as T;
	const form = $<HTMLFormElement>('form');
	const yen = (n: number) => `${Math.round(n).toLocaleString('ko-KR')}엔`;
	const num = (el: HTMLInputElement) => {
		const v = parseFloat(el.value.replace(/[^0-9.]/g, ''));
		return Number.isFinite(v) ? v : 0;
	};
	const radio = (name: string) => parseFloat(new FormData(form).get(name) as string) || 0;
	const setRadio = (name: string, v: number) => {
		const el = form.querySelector<HTMLInputElement>(`input[name="${name}"][value="${v}"]`);
		if (el) el.checked = true;
	};
	const man = (krw: number) => `약 ${Math.round(krw / 10000).toLocaleString('ko-KR')}만 원`;

	const read = () => ({
		rent: num($('rent')),
		mgmt: num($('mgmt')),
		shiki: radio('shiki'),
		rei: radio('rei'),
		fee: radio('fee'),
		guar: radio('guar'),
		date: $('date').value,
		next: $('next').checked,
		extras: EXTRAS.map((x) => ({ label: x.label, note: x.note, amount: num($(`a-${x.id}`)), on: $(`x-${x.id}`).checked })),
	});

	// 조건을 바꾸면 합계가 굴러가듯 바뀌고, 얼마나 늘고 줄었는지 잠깐 보여 준다.
	const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)');
	let shownTotal = 0;
	let targetTotal: number | null = null;
	let frame = 0;
	let deltaTimer = 0;
	let liveTimer = 0;
	let prevAmounts = new Map<string, number>();

	function paintTotal(v: number) {
		shownTotal = v;
		$('total').textContent = yen(v);
		$('bar-total').textContent = yen(v);
	}

	function showTotal(next: number) {
		const first = targetTotal === null;
		const diff = next - (targetTotal ?? next);
		targetTotal = next;
		if (first) return paintTotal(next);
		if (!diff) return;

		const chips = [$('delta'), $('bar-delta')];
		for (const chip of chips) {
			chip.textContent = `${diff > 0 ? '+' : '−'}${yen(Math.abs(diff))}`;
			chip.classList.add('is-on');
		}
		clearTimeout(deltaTimer);
		deltaTimer = window.setTimeout(() => chips.forEach((chip) => chip.classList.remove('is-on')), 1800);
		clearTimeout(liveTimer);
		liveTimer = window.setTimeout(() => {
			$('live').textContent = `합계 ${yen(next)}`;
		}, 600);

		cancelAnimationFrame(frame);
		if (reduceMotion.matches) return paintTotal(next);
		const from = shownTotal;
		const start = performance.now();
		const step = (now: number) => {
			const p = Math.min((now - start) / 250, 1);
			paintTotal(from + (next - from) * (1 - (1 - p) ** 3));
			if (p < 1) frame = requestAnimationFrame(step);
		};
		frame = requestAnimationFrame(step);
	}

	function render() {
		const s = read();
		const r = calcCost(s);
		const fx = num($('fx'));
		const firstRender = targetTotal === null;
		showTotal(r.total);
		$('sub').textContent = [
			r.months ? `집세의 ${r.months.toFixed(1)}개월분` : '',
			fx ? `${man((r.total * fx) / 100)} (100엔 = ${fx}원)` : '',
		]
			.filter(Boolean)
			.join(' · ');
		const keepPct = r.total ? (r.keep / r.total) * 100 : 0;
		for (const id of ['bar', 'mini']) {
			$(`${id}-keep`).style.width = `${keepPct}%`;
			$(`${id}-gone`).style.width = `${r.total ? 100 - keepPct : 0}%`;
		}
		$('keep').textContent = yen(r.keep);
		$('gone').textContent = yen(r.gone);
		$('items').replaceChildren(
			...r.items.map((it) => {
				const row = document.createElement('div');
				if (!it.amount) row.className = 'is-zero';
				if (!firstRender && prevAmounts.get(it.label) !== it.amount) row.classList.add('is-changed');
				const dt = document.createElement('dt');
				dt.textContent = it.label;
				if (it.amount) {
					const tag = document.createElement('span');
					tag.className = it.keep ? 'cost-tag is-keep' : 'cost-tag is-gone';
					tag.textContent = it.keep ? '반환' : '소멸';
					dt.append(tag);
				}
				if (it.note) {
					const note = document.createElement('small');
					note.textContent = it.note;
					dt.append(note);
				}
				const dd = document.createElement('dd');
				dd.textContent = yen(it.amount);
				row.append(dt, dd);
				return row;
			}),
		);
		prevAmounts = new Map(r.items.map((it) => [it.label, it.amount]));
		return { s, r, fx, sub: $('sub').textContent ?? '' };
	}

	const pressPreset = (key: string | null) =>
		form.querySelectorAll<HTMLButtonElement>('[data-preset]').forEach((b) => {
			b.setAttribute('aria-pressed', String(b.dataset.preset === key));
		});

	function applyPreset(key: keyof typeof PRESETS) {
		const p = PRESETS[key];
		setRadio('shiki', p.shiki);
		setRadio('rei', p.rei);
		setRadio('fee', p.fee);
		setRadio('guar', p.guar);
		$('next').checked = p.next;
		for (const x of EXTRAS) $(`x-${x.id}`).checked = (p.extras as readonly string[]).includes(x.id);
		pressPreset(key);
		render();
	}

	form.querySelectorAll<HTMLButtonElement>('[data-preset]').forEach((b) => {
		b.addEventListener('click', () => applyPreset(b.dataset.preset as keyof typeof PRESETS));
	});
	form.addEventListener('input', (e) => {
		const t = e.target as HTMLInputElement;
		if (t.type === 'radio' || t.type === 'checkbox') pressPreset(null);
		render();
	});
	form.addEventListener('submit', (e) => e.preventDefault());
	form.querySelectorAll<HTMLInputElement>('.cost-money input').forEach((el) => {
		if (el.id === 'cost-fx') return;
		el.addEventListener('blur', () => {
			const v = num(el);
			el.value = v ? v.toLocaleString('ko-KR') : '';
		});
	});

	// 유럽중앙은행 기준환율(영업일 하루 1회 갱신). 받지 못하면 입력칸의 예시 환율을 그대로 쓴다.
	let liveFx: { value: string; note: string } | null = null;
	let fxEdited = false;
	const showFx = () => {
		if (liveFx) $('fx').value = liveFx.value;
		$('fx-note').textContent = liveFx?.note ?? form.closest<HTMLElement>('.cost-calc')!.dataset.fxExampleNote!;
	};
	$('fx').addEventListener('input', () => {
		fxEdited = true;
		$('fx-note').textContent = '직접 입력한 환율로 계산합니다. 「처음 값으로」를 누르면 최신 환율로 돌아갑니다.';
	});
	fetch('https://api.frankfurter.dev/v1/latest?base=JPY&symbols=KRW', { signal: AbortSignal.timeout(5000) })
		.then((res) => res.json())
		.then((data) => {
			const rate = data.rates.KRW * 100;
			if (!(rate > 0)) return;
			const [, m, d] = data.date.split('-').map(Number);
			liveFx = {
				value: rate.toFixed(1),
				note: `${m}월 ${d}일 유럽중앙은행 기준환율입니다. 은행 송금 환율과 다르니 송금할 때 환율로 고쳐 넣으세요.`,
			};
			if (fxEdited) return;
			showFx();
			render();
		})
		.catch(() => {});

	$('reset').addEventListener('click', () => {
		form.reset();
		fxEdited = false;
		showFx();
		$('date').value = defaultMoveIn();
		applyPreset('std');
	});

	const dialog = $<HTMLDialogElement>('dialog');
	const image = $<HTMLImageElement>('image');
	const status = $('status');
	const pageUrl = () => `${location.origin}${location.pathname}`;
	const FILE_NAME = 'japan-initial-cost.png';
	let shared = render();
	let png: Blob | null = null;

	$('share').addEventListener('click', async () => {
		shared = render();
		const { r, sub } = shared;
		status.textContent = '';
		document.querySelector('.cost-fallback')?.remove();
		png = await drawShareCard({
			total: yen(r.total),
			sub: sub.split(' · '),
			keep: yen(r.keep),
			gone: yen(r.gone),
			keepRatio: r.total ? r.keep / r.total : 0,
			items: r.items.filter((it) => it.amount).map((it) => ({ label: it.label, amount: yen(it.amount) })),
			footer: ['일본 정착 기초 가이드', location.host],
		});
		const file = new File([png], FILE_NAME, { type: 'image/png' });
		URL.revokeObjectURL(image.src);
		image.src = URL.createObjectURL(png);
		image.alt = `초기비용 합계 ${yen(r.total)} 요약 이미지`;
		$('img-share').hidden = !navigator.canShare?.({ files: [file] });
		$('img-copy').hidden = !(navigator.clipboard?.write && 'ClipboardItem' in window);
		dialog.showModal();
	});

	$('close').addEventListener('click', () => dialog.close());
	dialog.addEventListener('click', (e) => {
		if (e.target === dialog) dialog.close();
	});

	$('img-share').addEventListener('click', () => {
		const file = new File([png!], FILE_NAME, { type: 'image/png' });
		navigator.share({ files: [file], text: pageUrl() }).catch((e) => {
			if (e.name !== 'AbortError') status.textContent = '공유하지 못했습니다. 이미지 저장을 이용하세요.';
		});
	});

	$('img-copy').addEventListener('click', () => {
		navigator.clipboard.write([new ClipboardItem({ 'image/png': png! })]).then(
			() => {
				status.textContent = '이미지를 복사했습니다. 카카오톡이나 메모에 붙여 넣으세요.';
			},
			() => {
				status.textContent = '이미지를 복사하지 못했습니다. 이미지 저장을 이용하세요.';
			},
		);
	});

	$('img-save').addEventListener('click', () => {
		const a = document.createElement('a');
		a.href = image.src;
		a.download = FILE_NAME;
		a.click();
	});

	$('copy').addEventListener('click', () => {
		const { s, r, fx } = shared;
		const text = [
			'[일본 집 초기비용 예상]',
			`집세 ${yen(s.rent)} + 관리비 ${yen(s.mgmt)}`,
			'',
			...r.items.filter((it) => it.amount).map((it) => `· ${it.label}: ${yen(it.amount)}`),
			'',
			`합계: ${yen(r.total)} (집세의 ${r.months.toFixed(1)}개월분)`,
			...(fx ? [`원화 ${man((r.total * fx) / 100)}`] : []),
			`그중 돌려받을 수 있는 돈(시키킨): ${yen(r.keep)}`,
			'',
			`계산해 보기: ${pageUrl()}`,
		].join('\n');
		const fallback = () => {
			document.querySelector('.cost-fallback')?.remove();
			const ta = document.createElement('textarea');
			ta.className = 'cost-fallback';
			ta.value = text;
			ta.readOnly = true;
			status.textContent = '자동 복사를 쓸 수 없습니다. 아래 내용을 길게 눌러 복사하세요.';
			status.after(ta);
			ta.select();
		};
		if (!navigator.clipboard) return fallback();
		navigator.clipboard.writeText(text).then(() => {
			status.textContent = '복사했습니다. 카카오톡이나 메모에 붙여 넣으세요.';
		}, fallback);
	});

	$('date').value = defaultMoveIn();
	render();
</script>

<style is:global>
	/* 동적으로 만드는 항목에도 적용되도록 전역 스타일로 쓰고 .cost-calc 아래로만 한정한다. 이 페이지에서만 불러온다. */
	.cost-calc {
		--c-keep: var(--krds-color-light-success-30);
		--c-keep-soft: var(--krds-color-light-success-90);
		--c-gone: var(--krds-color-light-danger-30);
		--c-gone-soft: var(--krds-color-light-danger-90);
		margin-block: 1.5rem;
		font-size: 0.9375rem;
		overflow-wrap: anywhere;
